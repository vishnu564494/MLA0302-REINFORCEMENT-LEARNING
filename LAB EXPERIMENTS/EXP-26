#Develop a recommendation system for a streaming service to suggest movies based on user
feedback, implemented as an MDP and trained using a Deep Deterministic Policy Gradient
(DDPG) algorithm.




import pandas as pd
import numpy as np
import tensorflow as tf
from tensorflow.keras import layers
import matplotlib.pyplot as plt
from google.colab import files

# 1. Upload CSV file
print("Upload streaming_movie_feedback_dataset.csv")
uploaded = files.upload()

file = list(uploaded.keys())[0]
df = pd.read_csv(file)

print("\nDataset:")
print(df.head())

# 2. Create user-movie matrix
ratings = df.pivot_table(
    index="user_id",
    columns="movie_id",
    values="rating",
    fill_value=0
)

n_movies = ratings.shape[1]

# 3. Actor network
actor = tf.keras.Sequential([
    layers.Dense(32, activation="relu"),
    layers.Dense(32, activation="relu"),
    layers.Dense(n_movies, activation="sigmoid")
])

# 4. Critic network
critic = tf.keras.Sequential([
    layers.Dense(32, activation="relu"),
    layers.Dense(32, activation="relu"),
    layers.Dense(1)
])

optimizer = tf.keras.optimizers.Adam(0.001)

# 5. DDPG training
rewards = []

for episode in range(50):

    user = np.random.choice(ratings.index)
    state = ratings.loc[user].values.astype("float32") / 5

    with tf.GradientTape() as tape:

        action = actor(tf.reshape(state, (1, -1)))[0]
        value = critic(tf.reshape(action, (1, -1)))[0]

        loss = -tf.reduce_mean(value)

    gradients = tape.gradient(
        loss,
        actor.trainable_variables
    )

    optimizer.apply_gradients(
        zip(gradients, actor.trainable_variables)
    )

    reward = float(np.mean(action))
    rewards.append(reward)

    if episode % 10 == 0:
        print("Episode:", episode,
              "Reward:", round(reward, 3))

# 6. Plot training reward
plt.plot(rewards)
plt.xlabel("Episode")
plt.ylabel("Reward")
plt.title("DDPG Training")
plt.show()

# 7. Recommend movies
user = 1

state = ratings.loc[user].values.astype("float32") / 5
scores = actor(tf.reshape(state, (1, -1))).numpy()[0]

top_movies = np.argsort(scores)[-5:][::-1]

print("\nRecommended Movies for User", user)

for i in top_movies:
    print(
        "Movie ID:", ratings.columns[i],
        "Score:", round(scores[i], 3)
